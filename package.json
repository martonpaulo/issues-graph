{
  "name": "issues-graph",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Hosted dependency graph for GitHub Issues",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "social-card": "npx --yes playwright@1.63.0 screenshot --viewport-size=1200,630 \"file://$PWD/design/social-card/social-card.html\" \"${TMPDIR:-/tmp}/issues-card.png\" && magick \"${TMPDIR:-/tmp}/issues-card.png\" -strip -quality 92 -sampling-factor 4:4:4 -interlace Plane public/social-card.jpg"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@xyflow/react": "^12.11.3",
    "elkjs": "^0.12.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.3.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.0",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fontkit": "^2.0.4",
    "globals": "^17.11.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
