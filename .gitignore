# Disposable agent scratch space (handoffs, prototypes)
.scratch/

# Node toolchain and build output
node_modules/
dist/

# Logs and caches
*.log
.cache/
tmp/
.tmp/

# OS and editor artifacts
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# This project uses npm; package-lock.json is the tracked lockfile. A second lockfile from
# another package manager resolves different versions without anyone noticing.
pnpm-lock.yaml
yarn.lock
